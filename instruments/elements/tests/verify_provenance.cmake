# Checks that the files copied from upstream are still what SHA256SUMS.upstream
# says they are: a file listed as verbatim has the upstream hash, one listed
# as patched does not. Run by CTest:
#   cmake -DPLUGIN_DIR=<instruments/elements> -P verify_provenance.cmake
cmake_minimum_required(VERSION 3.25)

if(NOT PLUGIN_DIR)
    message(FATAL_ERROR "PLUGIN_DIR is not set")
endif()

set(failures 0)
macro(fail text)
    message(STATUS "FAIL ${text}")
    math(EXPR failures "${failures} + 1")
endmacro()

# SHA-256 of a file's content with CRLF replaced by LF: what Git stores.
function(normalized_hash path result)
    file(READ "${path}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    string(SHA256 digest "${content}")
    set(${result} "${digest}" PARENT_SCOPE)
endfunction()

file(STRINGS "${PLUGIN_DIR}/SHA256SUMS.upstream" lines)
set(verbatim 0)
set(patched 0)
foreach(line IN LISTS lines)
    if(line MATCHES "^#" OR line STREQUAL "")
        continue()
    endif()
    if(NOT line MATCHES "^([0-9a-f]+)  (verbatim|patched)  ([^ ]+)  ([^ ]+)$")
        fail("line not understood: ${line}")
        continue()
    endif()
    set(upstream_hash "${CMAKE_MATCH_1}")
    set(relation "${CMAKE_MATCH_2}")
    set(local "${CMAKE_MATCH_3}")
    if(NOT EXISTS "${PLUGIN_DIR}/${local}")
        fail("${local} is listed but missing")
        continue()
    endif()
    normalized_hash("${PLUGIN_DIR}/${local}" actual)
    if(relation STREQUAL "verbatim")
        math(EXPR verbatim "${verbatim} + 1")
        if(NOT actual STREQUAL upstream_hash)
            fail("${local} is listed as verbatim but differs from upstream: ${actual}")
        endif()
    else()
        math(EXPR patched "${patched} + 1")
        if(actual STREQUAL upstream_hash)
            fail("${local} is listed as patched but is identical to upstream")
        endif()
    endif()
endforeach()

# Every file of the reference tree is listed: nothing unlisted is compiled
# into the comparison.
file(GLOB_RECURSE reference RELATIVE "${PLUGIN_DIR}" "${PLUGIN_DIR}/tests/reference/eurorack/*")
foreach(file IN LISTS reference)
    list(FILTER lines INCLUDE REGEX ".*")
    string(FIND "${lines}" "  ${file}  " found)
    if(found EQUAL -1)
        fail("${file} is in the reference tree but not listed")
    endif()
endforeach()

if(verbatim EQUAL 0 OR patched EQUAL 0)
    fail("the list is empty or one-sided: ${verbatim} verbatim, ${patched} patched")
endif()
if(failures GREATER 0)
    message(FATAL_ERROR "provenance: ${failures} failure(s)")
endif()
message(STATUS "provenance: ${verbatim} files as upstream, ${patched} patched, all as listed")
