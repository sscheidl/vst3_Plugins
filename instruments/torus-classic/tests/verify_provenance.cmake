# Checks that the files copied from Daisy-Seed are still what components.json
# and SHA256SUMS.upstream say they are, and that the version numbers agree.
# Run by CTest:
#   cmake -DPLUGIN_DIR=<instruments/torus-classic> -DBUILD_VERSION=<x.y.z> -P verify_provenance.cmake
cmake_minimum_required(VERSION 3.25)

if(NOT PLUGIN_DIR)
    message(FATAL_ERROR "PLUGIN_DIR is not set")
endif()

set(failures 0)
macro(fail text)
    message(STATUS "FAIL ${text}")
    math(EXPR failures "${failures} + 1")
endmacro()

# SHA-256 of a file's content with CRLF replaced by LF: what Git stores.
function(normalized_hash path result)
    file(READ "${path}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    string(SHA256 digest "${content}")
    set(${result} "${digest}" PARENT_SCOPE)
endfunction()

file(READ "${PLUGIN_DIR}/components.json" manifest)
string(JSON count LENGTH "${manifest}" files)
math(EXPR last "${count} - 1")
set(verbatim 0)
set(changed 0)
foreach(i RANGE ${last})
    string(JSON local GET "${manifest}" files ${i} local)
    string(JSON relation GET "${manifest}" files ${i} relation)
    string(JSON origin_hash GET "${manifest}" files ${i} origin_sha256)
    string(JSON local_hash GET "${manifest}" files ${i} local_sha256)
    if(NOT EXISTS "${PLUGIN_DIR}/${local}")
        fail("${local} is listed but missing")
        continue()
    endif()
    normalized_hash("${PLUGIN_DIR}/${local}" actual)
    if(NOT actual STREQUAL local_hash)
        fail("${local} has changed: ${actual}, listed ${local_hash}")
    endif()
    if(relation STREQUAL "verbatim")
        math(EXPR verbatim "${verbatim} + 1")
        if(NOT local_hash STREQUAL origin_hash)
            fail("${local} is listed as verbatim but its hash differs from the origin's")
        endif()
    else()
        math(EXPR changed "${changed} + 1")
        if(local_hash STREQUAL origin_hash)
            fail("${local} is listed as ${relation} but is identical to its origin")
        endif()
    endif()
    string(MAKE_C_IDENTIFIER "${local}" key)
    set(listed_${key} "${local_hash} ${relation} ${origin_hash}")
endforeach()

# The plain hash list says the same as the manifest.
file(STRINGS "${PLUGIN_DIR}/SHA256SUMS.upstream" lines)
set(sum_lines 0)
foreach(line IN LISTS lines)
    if(line MATCHES "^#" OR line STREQUAL "")
        continue()
    endif()
    if(NOT line MATCHES "^([0-9a-f]+)  ([^ ]+)  ([a-z]+)  ([0-9a-f]+)  ([^ ]+)$")
        fail("SHA256SUMS.upstream: cannot read '${line}'")
        continue()
    endif()
    math(EXPR sum_lines "${sum_lines} + 1")
    string(MAKE_C_IDENTIFIER "${CMAKE_MATCH_2}" key)
    if(NOT "${listed_${key}}" STREQUAL "${CMAKE_MATCH_1} ${CMAKE_MATCH_3} ${CMAKE_MATCH_4}")
        fail("SHA256SUMS.upstream and components.json disagree about ${CMAKE_MATCH_2}")
    endif()
endforeach()
if(NOT sum_lines EQUAL count)
    fail("SHA256SUMS.upstream lists ${sum_lines} files, components.json ${count}")
endif()

# One version number in every place that states it.
string(JSON product_version GET "${manifest}" product version)
file(READ "${PLUGIN_DIR}/source/version.h" version_header)
if(NOT version_header MATCHES "FULL_VERSION_STR \"([^\"]+)\"")
    fail("source/version.h has no FULL_VERSION_STR")
endif()
set(header_version "${CMAKE_MATCH_1}")
if(NOT header_version STREQUAL product_version)
    fail("version.h says ${header_version}, components.json ${product_version}")
endif()
if(BUILD_VERSION AND NOT BUILD_VERSION STREQUAL product_version)
    fail("CMakeLists.txt says ${BUILD_VERSION}, components.json ${product_version}")
endif()
foreach(pair "engine/dry_engine.h;kEngineVersion;torus-classic.engine"
             "adapter/stream_adapter.h;kAdapterVersion;torus-classic.adapter")
    list(GET pair 0 header)
    list(GET pair 1 constant)
    list(GET pair 2 component)
    file(READ "${PLUGIN_DIR}/${header}" text)
    if(NOT text MATCHES "${constant} = \"([^\"]+)\"")
        fail("${header} has no ${constant}")
        continue()
    endif()
    set(code_version "${CMAKE_MATCH_1}")
    string(JSON components LENGTH "${manifest}" components)
    math(EXPR last_component "${components} - 1")
    foreach(c RANGE ${last_component})
        string(JSON id GET "${manifest}" components ${c} id)
        if(id STREQUAL component)
            string(JSON listed GET "${manifest}" components ${c} version)
            if(NOT listed STREQUAL code_version)
                fail("${header} says ${code_version}, components.json ${listed} for ${component}")
            endif()
        endif()
    endforeach()
endforeach()

if(failures GREATER 0)
    message(FATAL_ERROR "provenance: ${failures} problem(s)")
endif()
message(STATUS "provenance: ${count} files match components.json and SHA256SUMS.upstream "
               "(${verbatim} verbatim, ${changed} patched, adapted or derived); version "
               "${product_version} everywhere")
